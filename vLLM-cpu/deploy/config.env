# Shared deploy settings for vLLM-cpu on k3s context 108
export KUBE_CONTEXT="${KUBE_CONTEXT:-108}"
export NAMESPACE="${NAMESPACE:-vllm-cpu}"

# Official CPU OpenAI image (pin x86_64)
export VLLM_IMAGE="${VLLM_IMAGE:-vllm/vllm-openai-cpu:v0.33.0-x86_64}"
# Stage2 uses python:3.12-slim + pip lmcache (standalone CUDA image is ~8GB).
export LMCACHE_IMAGE="${LMCACHE_IMAGE:-python:3.12-slim}"
export MODEL="${MODEL:-facebook/opt-125m}"
export DTYPE="${DTYPE:-bfloat16}"

# SeaweedFS (existing in kubeflow)
export SEAWEED_NS="${SEAWEED_NS:-kubeflow}"
export SEAWEED_SVC="${SEAWEED_SVC:-seaweedfs.${SEAWEED_NS}.svc}"
export SEAWEED_S3_PORT="${SEAWEED_S3_PORT:-8333}"
export SEAWEED_SECRET="${SEAWEED_SECRET:-mlpipeline-minio-artifact}"
export SEAWEED_BUCKET="${SEAWEED_BUCKET:-kv-cache}"

# Stage1 sizing (single pod)
export S1_KVCACHE_GIB="${S1_KVCACHE_GIB:-2}"
export S1_MAX_MODEL_LEN="${S1_MAX_MODEL_LEN:-512}"
export S1_MAX_NUM_SEQS="${S1_MAX_NUM_SEQS:-4}"
export S1_SWAP_GIB="${S1_SWAP_GIB:-1}"
export S1_CPU_REQ="${S1_CPU_REQ:-2}"
export S1_CPU_LIM="${S1_CPU_LIM:-4}"
export S1_MEM_REQ="${S1_MEM_REQ:-4Gi}"
export S1_MEM_LIM="${S1_MEM_LIM:-8Gi}"

# Stage2 sizing (per vLLM + LMCache)
export S2_KVCACHE_GIB="${S2_KVCACHE_GIB:-1}"
export S2_MAX_MODEL_LEN="${S2_MAX_MODEL_LEN:-256}"
export S2_MAX_NUM_SEQS="${S2_MAX_NUM_SEQS:-2}"
export S2_L1_GIB="${S2_L1_GIB:-2}"
export S2_CPU_REQ="${S2_CPU_REQ:-1}"
export S2_CPU_LIM="${S2_CPU_LIM:-3}"
export S2_MEM_REQ="${S2_MEM_REQ:-3Gi}"
export S2_MEM_LIM="${S2_MEM_LIM:-6Gi}"

export HF_HOME_PATH="${HF_HOME_PATH:-/data/hf-cache}"
