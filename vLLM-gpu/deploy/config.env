# Shared deploy settings for vLLM-gpu (CUDA / NVIDIA)
export KUBE_CONTEXT="${KUBE_CONTEXT:-108}"
export NAMESPACE="${NAMESPACE:-vllm-gpu}"

# Official CUDA OpenAI image (override per cluster CUDA/driver matrix)
export VLLM_IMAGE="${VLLM_IMAGE:-vllm/vllm-openai:v0.8.5}"
# LMCache server used by Stage2 shared-KV connector
export LMCACHE_IMAGE="${LMCACHE_IMAGE:-lmcache/lmcache-vllm:v0.3.1}"
export MODEL="${MODEL:-Qwen/Qwen2.5-7B-Instruct}"
export DTYPE="${DTYPE:-bfloat16}"
export TENSOR_PARALLEL_SIZE="${TENSOR_PARALLEL_SIZE:-1}"
export GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.92}"

# SeaweedFS / S3 cold tier (same cluster asset as CPU lab)
export SEAWEED_NS="${SEAWEED_NS:-kubeflow}"
export SEAWEED_SVC="${SEAWEED_SVC:-seaweedfs.${SEAWEED_NS}.svc}"
export SEAWEED_S3_PORT="${SEAWEED_S3_PORT:-8333}"
export SEAWEED_SECRET="${SEAWEED_SECRET:-mlpipeline-minio-artifact}"
export SEAWEED_BUCKET="${SEAWEED_BUCKET:-kv-cache-gpu}"

# Stage1 single engine
export S1_MAX_MODEL_LEN="${S1_MAX_MODEL_LEN:-8192}"
export S1_MAX_NUM_SEQS="${S1_MAX_NUM_SEQS:-64}"
export S1_MAX_NUM_BATCHED_TOKENS="${S1_MAX_NUM_BATCHED_TOKENS:-8192}"
export S1_GPU_COUNT="${S1_GPU_COUNT:-1}"
export S1_CPU_REQ="${S1_CPU_REQ:-4}"
export S1_CPU_LIM="${S1_CPU_LIM:-8}"
export S1_MEM_REQ="${S1_MEM_REQ:-16Gi}"
export S1_MEM_LIM="${S1_MEM_LIM:-32Gi}"

# Stage2 dual engine + LMCache
export S2_MAX_MODEL_LEN="${S2_MAX_MODEL_LEN:-4096}"
export S2_MAX_NUM_SEQS="${S2_MAX_NUM_SEQS:-32}"
export S2_GPU_COUNT="${S2_GPU_COUNT:-1}"
export S2_CPU_REQ="${S2_CPU_REQ:-4}"
export S2_CPU_LIM="${S2_CPU_LIM:-8}"
export S2_MEM_REQ="${S2_MEM_REQ:-16Gi}"
export S2_MEM_LIM="${S2_MEM_LIM:-32Gi}"
export S2_LMCACHE_CPU_REQ="${S2_LMCACHE_CPU_REQ:-1}"
export S2_LMCACHE_MEM_REQ="${S2_LMCACHE_MEM_REQ:-4Gi}"

# Stage3 PD pools
export S3_PREFILL_GPU="${S3_PREFILL_GPU:-1}"
export S3_DECODE_GPU="${S3_DECODE_GPU:-1}"
export S3_MAX_MODEL_LEN="${S3_MAX_MODEL_LEN:-8192}"

export HF_HOME_PATH="${HF_HOME_PATH:-/data/hf-cache}"
export NVIDIA_VISIBLE_DEVICES="${NVIDIA_VISIBLE_DEVICES:-all}"
